 },
 "pip/aaffba124f5a": {
  "file": "pip/aaffba124f5a.ogg",
  "text": "A fresh egg for your bag!",
  "duration": 1.53
 },
 "pip/ab127502d5da": {
  "file": "pip/ab127502d5da.ogg",
  "text": "Sheep give us wool.",
  "duration": 1.25
 },
 "pip/abfe655be0b6": {
  "file": "pip/abfe655be0b6.ogg",
  "text": "That made someone happy!",
  "duration": 1.55
 },
 "pip/add46ba1fbf7": {
  "file": "pip/add46ba1fbf7.ogg",
  "text": "A little water and sunshine helps plants grow.",
  "duration": 2.68
 },
 "pip/ae39bbd7f8d8": {
  "file": "pip/ae39bbd7f8d8.ogg",
  "text": "Shall we look at it together?",
  "duration": 1.61
 },
 "pip/b00485805376": {
  "file": "pip/b00485805376.ogg",
  "text": "This is the village. Lots of neighbours live here!",
  "duration": 3.49
 },
 "pip/b0a101eba162": {
  "file": "pip/b0a101eba162.ogg",
  "text": "Here we are, at the village!",
  "duration": 1.45
 },
 "pip/b0d84aa7e6e8": {
  "file": "pip/b0d84aa7e6e8.ogg",
  "text": "A raw potato. How crunchy!",
  "duration": 2.8
 },
 "pip/b1128ce18e59": {
  "file": "pip/b1128ce18e59.ogg",
  "text": "I'm waiting right here for you!",
  "duration": 1.71
 },
 "pip/b1422b6d7967": {
  "file": "pip/b1422b6d7967.ogg",
  "text": "Let's get some more blocks, then try!",
  "duration": 1.99
 },
 "pip/b31efa2c357f": {
  "file": "pip/b31efa2c357f.ogg",
  "text": "Whoops! Let me help you up!",
  "duration": 2.18
 },
 "pip/b7e505e1f223": {
  "file": "pip/b7e505e1f223.ogg",
  "text": "This way, follow me!",
  "duration": 1.33
 },
 "pip/b8dabd1632cc": {
  "file": "pip/b8dabd1632cc.ogg",
  "text": "Someone has a light on a hill.",
  "duration": 1.79
 },
 "pip/be05c367eeb3": {
  "file": "pip/be05c367eeb3.ogg",
  "text": "Press and hold a block to dig it!",
  "duration": 1.77
 },
 "pip/bf6a46a0f9d1": {
  "file": "pip/bf6a46a0f9d1.ogg",
  "text": "Smashing! You found a lovely block!",
  "duration": 2.64
 },
 "pip/c10e19352b37": {
  "file": "pip/c10e19352b37.ogg",
  "text": "Hold your finger on a tree to get wood!",
  "duration": 2.13
 },
 "pip/c1c90b3d437c": {
  "file": "pip/c1c90b3d437c.ogg",
  "text": "A lovely orange carrot!",
  "duration": 1.49
 },
 "pip/c2afbbdf6e6b": {
  "file": "pip/c2afbbdf6e6b.ogg",
  "text": "A crunchy little potato!",
  "duration": 1.73
 },
 "pip/c47a010be57a": {
  "file": "pip/c47a010be57a.ogg",
  "text": "What are you making?",
  "duration": 1.25
 },
 "pip/c56c96a02642": {
  "file": "pip/c56c96a02642.ogg",
  "text": "Soft wool for your bag!",
  "duration": 1.43
 },
 "pip/c5720213d5ed": {
  "file": "pip/c5720213d5ed.ogg",
  "text": "There is a wizard in the tower. Follow me.",
  "duration": 3.23
 },
 "pip/ca1b74eae92e": {
  "file": "pip/ca1b74eae92e.ogg",
  "text": "It's ready! Press and hold to pick it.",
  "duration": 2.72
 },
 "pip/d293ee33a54c": {
  "file": "pip/d293ee33a54c.ogg",
  "text": "Hiya! I'm Pip. Let's go exploring!",
  "duration": 3.74
 },
 "pip/d44c764c662c": {
  "file": "pip/d44c764c662c.ogg",
  "text": "Plants grow with water and sunshine.",
  "duration": 2.09
 },
 "pip/da05bf810d02": {
  "file": "pip/da05bf810d02.ogg",
  "text": "Goodness! Look at that!",
  "duration": 2.12
 },
 "pip/db0dfa23ae41": {
  "file": "pip/db0dfa23ae41.ogg",
  "text": "Hello again! I'm so happy you're here!",
  "duration": 2.91
 },
 "pip/dd1df1de9a74": {
  "file": "pip/dd1df1de9a74.ogg",
  "text": "Home sweet home!",
  "duration": 1.25
 },
 "pip/dd41b5bebe2d": {
  "file": "pip/dd41b5bebe2d.ogg",
  "text": "Fantastic! Well done!",
  "duration": 2.16
 },
 "pip/df07bb4a37aa": {
  "file": "pip/df07bb4a37aa.ogg",
  "text": "We need a few more blocks first.",
  "duration": 1.85
 },
 "pip/e08a2e286120": {
  "file": "pip/e08a2e286120.ogg",
  "text": "Animals like food. Pick some and visit them.",
  "duration": 3.27
 },
 "pip/e1fb5580fc4b": {
  "file": "pip/e1fb5580fc4b.ogg",
  "text": "That's a bit tricky. Shall we go round?",
  "duration": 3.07
 },
 "pip/e3b8f607be8b": {
  "file": "pip/e3b8f607be8b.ogg",
  "text": "A plant is ready. Press and hold to pick it!",
  "duration": 3.29
 },
 "pip/e3de6a810757": {
  "file": "pip/e3de6a810757.ogg",
  "text": "Let's look at each picture slowly.",
  "duration": 1.99
 },
 "pip/e4709aafee3f": {
  "file": "pip/e4709aafee3f.ogg",
  "text": "Super! You got another!",
  "duration": 2.12
 },
 "pip/e54c5b7b2971": {
  "file": "pip/e54c5b7b2971.ogg",
  "text": "We're in the village! Let's say hello!",
  "duration": 2.64
 },
 "pip/e5bdc8fd2586": {
  "file": "pip/e5bdc8fd2586.ogg",
  "text": "Apples grow on trees.",
  "duration": 1.61
 },
 "pip/ed29850853f5": {
  "file": "pip/ed29850853f5.ogg",
  "text": "I'll show you the way!",
  "duration": 1.23
 },
 "pip/ee35119baf0f": {
  "file": "pip/ee35119baf0f.ogg",
  "text": "Press and hold a ripe plant to pick it.",
  "duration": 2.23
 },
 "pip/ee6ca3a5421b": {
  "file": "pip/ee6ca3a5421b.ogg",
  "text": "Hiya! You came back!",
  "duration": 2.02
 },
 "pip/f0e8bf952324": {
  "file": "pip/f0e8bf952324.ogg",
  "text": "That's plenty of those! Let's use some.",
  "duration": 2.91
 },
 "pip/f2915b4ee66f": {
  "file": "pip/f2915b4ee66f.ogg",
  "text": "Ready to pick! Press and hold it.",
  "duration": 2.6
 },
 "pip/f363607cbbb2": {
  "file": "pip/f363607cbbb2.ogg",
  "text": "A nice cuddle!",
  "duration": 1.13
 },
 "pip/f476248fd5ac": {
  "file": "pip/f476248fd5ac.ogg",
  "text": "Let's stretch up high! Reach for the sky!",
  "duration": 2.93
 },
 "pip/f6c1ef897dc3": {
  "file": "pip/f6c1ef897dc3.ogg",
  "text": "Fresh milk for your bag!",
  "duration": 1.47
 },
 "pip/f7ffd26bdb48": {
  "file": "pip/f7ffd26bdb48.ogg",
  "text": "A magic block! Where will you put it?",
  "duration": 2.95
 },
 "pip/f9296dfd9799": {
  "file": "pip/f9296dfd9799.ogg",
  "text": "Let's collect the blocks we need!",
  "duration": 1.71
 },
 "pip/fb5c4ec5a61f": {
  "file": "pip/fb5c4ec5a61f.ogg",
  "text": "Up you come!",
  "duration": 0.91
 },
 "pip/fc89195f28d4": {
  "file": "pip/fc89195f28d4.ogg",
  "text": "Plants start as seeds. Shall we grow some?",
  "duration": 3.17
 },
 "wizard/0803c20fe9ea": {
  "file": "wizard/0803c20fe9ea.ogg",
  "text": "Look at the glowing picture.",
  "duration": 1.51
 },
 "wizard/08a195a5e778": {
  "file": "wizard/08a195a5e778.ogg",
  "text": "Can you solve my puzzle, young friend?",
  "duration": 2.38
 },
 "wizard/0980251c778a": {
  "file": "wizard/0980251c778a.ogg",
  "text": "Which one matches?",
  "duration": 1.36
 },
 "wizard/09d857a2677e": {
  "file": "wizard/09d857a2677e.ogg",
  "text": "Come in, come in. Mind the stairs.",
  "duration": 2.79
 },
 "wizard/09de7768e36f": {
  "file": "wizard/09de7768e36f.ogg",
  "text": "You solved it, young friend.",
  "duration": 1.76
 },
 "wizard/0b7b768af110": {
  "file": "wizard/0b7b768af110.ogg",
  "text": "Which picture comes next?",
  "duration": 1.72
 },
 "wizard/0c13710b6540": {
  "file": "wizard/0c13710b6540.ogg",
  "text": "The stars will be here, young friend.",
  "duration": 2.28
 },
 "wizard/0cc78df1faa0": {
  "file": "wizard/0cc78df1faa0.ogg",
  "text": "That was a tricky one. Well done.",
  "duration": 2.92
 },
 "wizard/0d8691616df8": {
  "file": "wizard/0d8691616df8.ogg",
  "text": "Choose a block. Gems are what I like best.",
  "duration": 3.4
 },
 "wizard/14b32067e579": {
  "file": "wizard/14b32067e579.ogg",
  "text": "Glim says you should pick a gift.",
  "duration": 1.92
 },
 "wizard/1552af770990": {
  "file": "wizard/1552af770990.ogg",
  "text": "Choose one magic block. It is my gift to you.",
  "duration": 3.67
 },
 "wizard/155962bda9a6": {
  "file": "wizard/155962bda9a6.ogg",
  "text": "Come back whenever you like.",
  "duration": 1.63
 },
 "wizard/17b6f75c9a23": {
  "file": "wizard/17b6f75c9a23.ogg",
  "text": "Look closely. Something is shining.",
  "duration": 2.92
 },
 "wizard/206d637de4a5": {
  "file": "wizard/206d637de4a5.ogg",
  "text": "Slowly does it. Look at each picture.",
  "duration": 3.13
 },
 "wizard/2113e7923823": {
  "file": "wizard/2113e7923823.ogg",
  "text": "Have another look.",
  "duration": 1.15
 },
 "wizard/22df0147ef87": {
  "file": "wizard/22df0147ef87.ogg",
  "text": "Not enough gems yet. Would you like a puzzle?",
  "duration": 3.5
 },
 "wizard/29e0789156cb": {
  "file": "wizard/29e0789156cb.ogg",
  "text": "A fine choice. Glim approves.",
  "duration": 2.79
 },
 "wizard/2d7ccca0a574": {
  "file": "wizard/2d7ccca0a574.ogg",
  "text": "Your bag is full of those. Build with some!",
  "duration": 3.23
 },
 "wizard/2f10cfcd85fa": {
  "file": "wizard/2f10cfcd85fa.ogg",
  "text": "Not quite. Try once more.",
  "duration": 2.54
 },
 "wizard/3219083708de": {
  "file": "wizard/3219083708de.ogg",
  "text": "Glim and I helped a little. Well done.",
  "duration": 3.17
 },
 "wizard/37e6afb13cc2": {
  "file": "wizard/37e6afb13cc2.ogg",
  "text": "What comes next?",
  "duration": 1.38
 },
 "wizard/38a9de4b9ef1": {
  "file": "wizard/38a9de4b9ef1.ogg",
  "text": "I would like",
  "duration": 1.02
 },
 "wizard/3e2e95f5ad97": {
  "file": "wizard/3e2e95f5ad97.ogg",
  "text": "potato",
  "duration": 0.88
 },
 "wizard/4a8d119bcece": {
  "file": "wizard/4a8d119bcece.ogg",
  "text": "Look at the row. What comes next?",
  "duration": 2.96
 },
 "wizard/4b00583431c7": {
  "file": "wizard/4b00583431c7.ogg",
  "text": "Glim and I will be here.",
  "duration": 1.8
 },
 "wizard/4db2c1df4610": {
  "file": "wizard/4db2c1df4610.ogg",
  "text": "five",
  "duration": 0.69
 },
 "wizard/4fa6024f1249": {
  "file": "wizard/4fa6024f1249.ogg",
  "text": "egg",
  "duration": 0.65
 },
 "wizard/4fb2be0c20f1": {
  "file": "wizard/4fb2be0c20f1.ogg",
  "text": "Can you finish the row?",
  "duration": 1.51
 },
 "wizard/4ffc80205a8f": {
  "file": "wizard/4ffc80205a8f.ogg",
  "text": "Quite right. Glim is pleased.",
  "duration": 2.73
 },
 "wizard/56544addf847": {
  "file": "wizard/56544addf847.ogg",
  "text": "bundle of wheat",
  "duration": 1.34
 },
 "wizard/56a565dad9ce": {
  "file": "wizard/56a565dad9ce.ogg",
  "text": "You have plenty of those. Build with some first.",
  "duration": 3.61
 },
 "wizard/5a61046853f2": {
  "file": "wizard/5a61046853f2.ogg",
  "text": "Bring me",
  "duration": 0.86
 },
 "wizard/5ccf6d56c545": {
  "file": "wizard/5ccf6d56c545.ogg",
  "text": "Use some first, then come back.",
  "duration": 2.05
 },
 "wizard/5cf896e678bd": {
  "file": "wizard/5cf896e678bd.ogg",
  "text": "fifteen",
  "duration": 0.86
 },
 "wizard/626512c14539": {
  "file": "wizard/626512c14539.ogg",
  "text": "Glim and I were counting stars.",
  "duration": 2.05
 },
 "wizard/63061230a84d": {
  "file": "wizard/63061230a84d.ogg",
  "text": "Please put in my basket",
  "duration": 1.69
 },
 "wizard/64ab24335af6": {
  "file": "wizard/64ab24335af6.ogg",
  "text": "Magic blocks for shiny gems. Choose one.",
  "duration": 3.46
 },
 "wizard/6c0de8698dec": {
  "file": "wizard/6c0de8698dec.ogg",
  "text": "Take another look. Glim is helping.",
  "duration": 2.94
 },
 "wizard/6f904e7cdc49": {
  "file": "wizard/6f904e7cdc49.ogg",
  "text": "Find the one that is the same.",
  "duration": 1.82
 },
 "wizard/70c6adb61515": {
  "file": "wizard/70c6adb61515.ogg",
  "text": "eighteen",
  "duration": 0.9
 },
 "wizard/72c51ac7f8d7": {
  "file": "wizard/72c51ac7f8d7.ogg",
  "text": "bundles of wheat",
  "duration": 1.4
 },
 "wizard/76c2436b593f": {
  "file": "wizard/76c2436b593f.ogg",
  "text": "apples",
  "duration": 0.82
 },
 "wizard/78af1f170000": {
  "file": "wizard/78af1f170000.ogg",
  "text": "Hello, young friend. I am Orlo the wizard.",
  "duration": 3.34
 },
 "wizard/7a0ed756c3ab": {
  "file": "wizard/7a0ed756c3ab.ogg",
  "text": "Here is a puzzle for you.",
  "duration": 1.59
 },
 "wizard/7d34a9ae6f75": {
  "file": "wizard/7d34a9ae6f75.ogg",
  "text": "Not that one. Try again.",
  "duration": 2.46
 },
 "wizard/7ecb51f231e2": {
  "file": "wizard/7ecb51f231e2.ogg",
  "text": "Welcome to my tower, young friend.",
  "duration": 2.3
 },
 "wizard/8269d62b12d5": {
  "file": "wizard/8269d62b12d5.ogg",
  "text": "Puzzles are free. Shall we try one?",
  "duration": 2.98
 },
 "wizard/864c57ea2d6f": {
  "file": "wizard/864c57ea2d6f.ogg",
  "text": "A gift for you, young friend. Choose a block.",
  "duration": 3.32
 },
 "wizard/8819d19069fa": {
  "file": "wizard/8819d19069fa.ogg",
  "text": "potatoes",
  "duration": 0.98
 },
 "wizard/885c39aca07c": {
  "file": "wizard/885c39aca07c.ogg",
  "text": "nineteen",
  "duration": 0.92
 },
 "wizard/8a13a01d705b": {
  "file": "wizard/8a13a01d705b.ogg",
  "text": "fourteen",
  "duration": 0.86
 },
 "wizard/8ca439a9a044": {
  "file": "wizard/8ca439a9a044.ogg",
  "text": "Glim is making it easier for you.",
  "duration": 2.11
 },
 "wizard/9694e6397cac": {
  "file": "wizard/9694e6397cac.ogg",
  "text": "Together we did it.",
  "duration": 1.4
 },
 "wizard/9f8f7eec5dea": {
  "file": "wizard/9f8f7eec5dea.ogg",
  "text": "four",
  "duration": 0.71
 },
 "wizard/a00bbe560e6b": {
  "file": "wizard/a00bbe560e6b.ogg",
  "text": "seven",
  "duration": 0.77
 },
 "wizard/a1a21e764a5a": {
  "file": "wizard/a1a21e764a5a.ogg",
  "text": "Let us try a puzzle together.",
  "duration": 1.78
 },
 "wizard/a4b0dfa872d2": {
  "file": "wizard/a4b0dfa872d2.ogg",
  "text": "Shiny gems buy sets of magic blocks.",
  "duration": 2.7
 },
 "wizard/a74e59d4d328": {
  "file": "wizard/a74e59d4d328.ogg",
  "text": "Four magic blocks for you, young friend.",
  "duration": 2.28
 },
 "wizard/a91de6b09d9b": {
  "file": "wizard/a91de6b09d9b.ogg",
  "text": "Bring me a gem, or try a puzzle.",
  "duration": 2.18
 },
 "wizard/a9b437fe4745": {
  "file": "wizard/a9b437fe4745.ogg",
  "text": "Glim thinks it is this one.",
  "duration": 1.84
 },
 "wizard/aa86da6bd078": {
  "file": "wizard/aa86da6bd078.ogg",
  "text": "Find the matching picture.",
  "duration": 1.53
 },
 "wizard/ab9d02841706": {
  "file": "wizard/ab9d02841706.ogg",
  "text": "Come and see Glim and me again.",
  "duration": 1.69
 },
 "wizard/ad782ecdac77": {
  "file": "wizard/ad782ecdac77.ogg",
  "text": "two",
  "duration": 0.63
 },
 "wizard/b2bf0fff0ddf": {
  "file": "wizard/b2bf0fff0ddf.ogg",
  "text": "That is right! You are very clever.",
  "duration": 2.82
 },
 "wizard/b4ddce182ecf": {
  "file": "wizard/b4ddce182ecf.ogg",
  "text": "nine",
  "duration": 0.71
 },
 "wizard/b521f9394fab": {
  "file": "wizard/b521f9394fab.ogg",
  "text": "twelve",
  "duration": 0.75
 },
 "wizard/b802f384302c": {
  "file": "wizard/b802f384302c.ogg",
  "text": "three",
  "duration": 0.71
 },
 "wizard/bcc180cc3322": {
  "file": "wizard/bcc180cc3322.ogg",
  "text": "Fill my basket with",
  "duration": 1.44
 },
 "wizard/bd111dcb4b34": {
  "file": "wizard/bd111dcb4b34.ogg",
  "text": "eggs",
  "duration": 0.69
 },
 "wizard/bec9703f7a45": {
  "file": "wizard/bec9703f7a45.ogg",
  "text": "six",
  "duration": 0.63
 },
 "wizard/bf2c9d27e329": {
  "file": "wizard/bf2c9d27e329.ogg",
  "text": "Look carefully. Which is the same?",
  "duration": 2.92
 },
 "wizard/c0d94d09a927": {
  "file": "wizard/c0d94d09a927.ogg",
  "text": "sixteen",
  "duration": 0.92
 },
 "wizard/c0ee962ff9e0": {
  "file": "wizard/c0ee962ff9e0.ogg",
  "text": "Splendid. You worked it out.",
  "duration": 2.6
 },
 "wizard/c124fbcfe579": {
  "file": "wizard/c124fbcfe579.ogg",
  "text": "Those will look lovely in your house.",
  "duration": 2.09
 },
 "wizard/c1777d8e8486": {
  "file": "wizard/c1777d8e8486.ogg",
  "text": "seventeen",
  "duration": 0.98
 },
 "wizard/c22f6452ec49": {
  "file": "wizard/c22f6452ec49.ogg",
  "text": "A little puzzle, just for you.",
  "duration": 1.92
 },
 "wizard/c24f5cff02c0": {
  "file": "wizard/c24f5cff02c0.ogg",
  "text": "thirteen",
  "duration": 0.92
 },
 "wizard/c5310db16399": {
  "file": "wizard/c5310db16399.ogg",
  "text": "There you are. Build something wonderful.",
  "duration": 3.13
 },
 "wizard/cc5a0c506761": {
  "file": "wizard/cc5a0c506761.ogg",
  "text": "eleven",
  "duration": 0.86
 },
 "wizard/cffa50a32cb1": {
  "file": "wizard/cffa50a32cb1.ogg",
  "text": "and",
  "duration": 0.67
 },
 "wizard/d0be2dc421be": {
  "file": "wizard/d0be2dc421be.ogg",
  "text": "apple",
  "duration": 0.77
 },
 "wizard/d479fa0ef925": {
  "file": "wizard/d479fa0ef925.ogg",
  "text": "eight",
  "duration": 0.65
 },
 "wizard/d5f2b384f4ce": {
  "file": "wizard/d5f2b384f4ce.ogg",
  "text": "Gems turn into magic blocks in my tower.",
  "duration": 2.61
 },
 "wizard/d8bfad4b74d5": {
  "file": "wizard/d8bfad4b74d5.ogg",
  "text": "carrot",
  "duration": 0.69
 },
 "wizard/dbdc2217599d": {
  "file": "wizard/dbdc2217599d.ogg",
  "text": "Every new friend gets one gift. Choose a magic block.",
